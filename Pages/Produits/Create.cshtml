@page
@model GestionProduits.Pages.Produits.CreateModel
@{
    ViewData["Title"] = "Nouveau produit";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h1 class="h4 mb-0">Nouveau produit</h1>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Produit.Nom" class="form-label"></label>
                        <input asp-for="Produit.Nom" class="form-control" placeholder="Ex : Clavier mécanique" />
                        <span asp-validation-for="Produit.Nom" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Produit.Prix" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Produit.Prix" class="form-control" />
                            <span class="input-group-text">DT</span>
                        </div>
                        <span asp-validation-for="Produit.Prix" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Produit.CategorieId" class="form-label"></label>
                        <select asp-for="Produit.CategorieId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Choisir une catégorie --</option>
                        </select>
                        <span asp-validation-for="Produit.CategorieId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="/Index" class="btn btn-outline-primary">Annuler</a>
                        <button type="submit" class="btn btn-primary-brand px-4">Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}